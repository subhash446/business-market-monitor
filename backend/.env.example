NODE_ENV=development
PORT=5000

# Database (Document 4 — MySQL 8.0.16+ required)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=business_market_monitor
DB_USER=root
DB_PASSWORD=

# Database SSL (Production Hardening Phase A, finding D4) — optional,
# disabled by default so local/dev setups are unaffected. Set
# DB_SSL_ENABLED=true for managed MySQL providers that require/recommend
# TLS (e.g. Render Managed MySQL).
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT (Document 5 §2.1 -- access/refresh use DIFFERENT secrets)
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# SMTP / Nodemailer (Document 3)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# CORS (Document 3 §13)
CORS_ALLOWED_ORIGIN=http://localhost:5000

# Auth rate limiting (Document 5 v1.1 §5)
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Scheduled jobs (Document 3 §8, §9, §10)
PRICE_INGESTION_CRON=0 5 * * *
NEWS_INGESTION_CRON=0 * * * *
ALERT_EVALUATION_CRON=*/15 * * * *

# Optional -- only if the selected free government dataset requires a key (Document 3 ADR)
GOV_DATA_API_KEY=

# Password Reset (FR-AUTH-07) -- how long a reset link stays valid
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=60

# Automatic Price Ingestion (Phase A — EIA Provider)
PRICE_INGESTION_ENABLED=false
PRICE_PROVIDER_TIMEOUT_MS=15000
EIA_API_KEY=
EIA_API_BASE_URL=https://api.eia.gov/v2

# Automatic News Ingestion (Phase G — GNews Provider)
NEWS_INGESTION_ENABLED=false
NEWS_PROVIDER_TIMEOUT_MS=15000
GNEWS_API_KEY=
GNEWS_API_BASE_URL=https://gnews.io/api/v4

# Automatic AI Market Intelligence (Phase H — Gemini Provider)
AI_INSIGHTS_ENABLED=false
AI_INSIGHTS_CRON=0 6 * * *
AI_INSIGHTS_TIMEOUT_MS=30000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
